{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/capture/**",
              "components/core/**",
              "components/data/**",
              "components/fields/**",
              "ui_kits/murmur-ios/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Hanken Grotesk|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Hanken Grotesk, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|theme|style|key|ref|className|style|children)$/]",
        "message": "<AppIcon> doesn't accept that prop. Declared props: size, theme, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIcon'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<AppIcon> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIconM'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|theme|style|key|ref|className|style|children)$/]",
        "message": "<AppIconM> doesn't accept that prop. Declared props: size, theme, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIconM'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<AppIconM> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|fullWidth|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, fullWidth, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptureBloom'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|level|size|onTap|label|style|key|ref|className|style|children)$/]",
        "message": "<CaptureBloom> doesn't accept that prop. Declared props: state, level, size, onTap, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptureBloom'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|listening|thinking|done)$/]",
        "message": "<CaptureBloom> state must be one of 'idle' | 'listening' | 'thinking' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinationBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:destination|variant|style|key|ref|className|style|children)$/]",
        "message": "<DestinationBadge> doesn't accept that prop. Declared props: destination, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinationBadge'] > JSXAttribute[name.name='destination'] > Literal[value!=/^(?:reminder|event)$/]",
        "message": "<DestinationBadge> destination must be one of 'reminder' | 'event'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinationBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:chip|glyph|quiet)$/]",
        "message": "<DestinationBadge> variant must be one of 'chip' | 'glyph' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinationToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|size|style|key|ref|className|style|children)$/]",
        "message": "<DestinationToggle> doesn't accept that prop. Declared props: value, onChange, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinationToggle'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:reminder|event)$/]",
        "message": "<DestinationToggle> value must be one of 'reminder' | 'event'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DestinationToggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<DestinationToggle> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditableField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|icon|editing|muted|onPress|onChange|children|style|key|ref|className|style|children)$/]",
        "message": "<EditableField> doesn't accept that prop. Declared props: label, value, placeholder, icon, editing, muted, onPress, onChange, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, body, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|destination|when|relative|swiped|divider|onPress|onSwipe|onDelete|style|key|ref|className|style|children)$/]",
        "message": "<HistoryRow> doesn't accept that prop. Declared props: title, destination, when, relative, swiped, divider, onPress, onSwipe, onDelete, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HistoryRow'] > JSXAttribute[name.name='destination'] > Literal[value!=/^(?:reminder|event)$/]",
        "message": "<HistoryRow> destination must be one of 'reminder' | 'event'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeScale|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeScale, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|size|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, size, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:quiet|surface|accent)$/]",
        "message": "<IconButton> tone must be one of 'quiet' | 'surface' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PermissionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|status|hint|onFix|divider|style|key|ref|className|style|children)$/]",
        "message": "<PermissionRow> doesn't accept that prop. Declared props: label, status, hint, onFix, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PermissionRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:granted|needed)$/]",
        "message": "<PermissionRow> status must be one of 'granted' | 'needed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuccessBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|destination|onUndo|style|key|ref|className|style|children)$/]",
        "message": "<SuccessBar> doesn't accept that prop. Declared props: message, destination, onUndo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuccessBar'] > JSXAttribute[name.name='destination'] > Literal[value!=/^(?:reminder|event)$/]",
        "message": "<SuccessBar> destination must be one of 'reminder' | 'event'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|checked|onChange|divider|style|key|ref|className|style|children)$/]",
        "message": "<ToggleRow> doesn't accept that prop. Declared props: label, description, checked, onChange, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Transcript'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|partial|placeholder|align|style|key|ref|className|style|children)$/]",
        "message": "<Transcript> doesn't accept that prop. Declared props: text, partial, placeholder, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Transcript'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<Transcript> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|dot|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tone, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|inverse|accent)$/]",
        "message": "<Wordmark> tone must be one of 'primary' | 'inverse' | 'accent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
